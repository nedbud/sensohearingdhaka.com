# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
.next
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# No file holding real configuration belongs in this repository. The deployed
# site reads its values from Vercel's environment variables; development reads
# .env.local, which stays on your machine. .env.example documents what exists.
.env
.env.*
!.env.example

# Files moved aside instead of deleted. The device bridge cannot remove a
# file in a shared folder, so work that is finished with lands here and the
# person empties it when they like; none of it belongs in the repository.
_to_delete/
